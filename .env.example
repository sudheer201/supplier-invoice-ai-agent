# mock = free local run (no AWS). aws = Amazon Textract + Amazon Bedrock
APP_MODE=mock

AWS_REGION=us-east-1
# Copy the exact model ID or inference-profile ID from Bedrock console -> Model catalog
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# Optional: Bedrock Guardrail created in the console
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT
# USD per 1K tokens for the model above (check the Bedrock pricing page)
PRICE_INPUT_PER_1K=0.00025
PRICE_OUTPUT_PER_1K=0.00125

# Business rules
PRICE_TOLERANCE_PCT=2.0
AUTO_APPROVE_LIMIT=10000

# Set to require an x-api-key header
API_KEY=
